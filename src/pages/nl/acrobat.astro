---
	import Layout from '@layouts/LayoutSlides.astro'

    const title = 'Toegankelijke PDF met Acrobat'
---

<Layout title={ title }>
    <!-- Introduction -->
    <NlSharedInstructions />
    <NlSharedLogo />
    <NlAcrobatTitle />
    <NlAcrobatIntro />
    
    <!-- Document Properties -->
    <NlAcrobatDocumentProperties />
    
    <!-- PDF tags -->
    <NlAcrobatTags />
    
    <!-- Add tags -->
    <NlAcrobatAddTags />
    
    <!-- Method one -->
    <NlAcrobatMethodOne />

    <!-- Method two -->
    <NlAcrobatMethodTwo />
    
    <!-- Tips -->
    <NlAcrobatTips />
    
    <!-- Image -->
    <NlAcrobatImage />
    
    <!-- Link -->
    <NlAcrobatLink />

    <!-- Exercise -->
    <NlAcrobatExercise />
</Layout>
