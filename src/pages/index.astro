---
import 'reveal.js/reveal.css'
import 'reveal.js/theme/simple.css'
import '../assets/css/theme/anysurfer.css'
import '../assets/css/theme/anysurfer-wave.css'

import Layout from '../layouts/Layout.astro'
import Deck from '../components/Deck.astro'
---

<Layout>
	<Deck />
</Layout>

<script>
	import Reveal, { type TransitionStyle, type TransitionSpeed } from 'reveal.js'
	import highlight from 'reveal.js/plugin/highlight'
	import notes from 'reveal.js/plugin/notes'
	import initAnySurferWave from '../assets/script/anysurfer-wave.ts'

	/* AnySurfer CONSTANTS */
	const AS_TRANSITION: TransitionStyle = 'slide'
	const AS_TRANSITION_SPEED:TransitionSpeed = 'slow'

	/* Handle reduced motion */
	const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
	const isReducedMotion = mediaQuery.matches
	const handleMotionPreference = (e: MediaQueryListEvent) => {
		deck.configure({
			transition: mediaQuery.matches ? 'none' : AS_TRANSITION
		})
	}
	mediaQuery.addEventListener('change', handleMotionPreference)
	
	/* Init Reveal.js */
	const deck = new Reveal({
		plugins: [highlight, notes]
	});

	deck.initialize({
		controls: false, // custom controls
		progress: true,
		history: true,
		center: true,
		transition: isReducedMotion ? 'none' : AS_TRANSITION,
		transitionSpeed: AS_TRANSITION_SPEED,
	}).then(() => {
		initAnySurferWave(deck)
	})
</script>
