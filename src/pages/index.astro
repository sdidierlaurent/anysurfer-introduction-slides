---
import 'reveal.js/reveal.css';
import 'reveal.js/theme/simple.css';
import '../assets/css/theme/anysurfer.css';
import '../assets/css/theme/anysurfer-wave.css';

import Layout from '../layouts/Layout.astro';
import Deck from '../components/Deck.astro'
---

<Layout>
	<Deck />
</Layout>

<script>
import Reveal from 'reveal.js';
import highlight from 'reveal.js/plugin/highlight'; // ajouter CSS
import notes from 'reveal.js/plugin/notes';

	let deck = new Reveal({
		plugins:[highlight,notes]
	});
	deck.initialize({
		controls: true,
		progress: true,
		history: true,
		center: true,
		//theme ?
		transition: 'slide' // none/fade/slide/convex/concave/zoom
	});
</script>
<script src="/src/assets/script/anysurfer-wave.js"></script>
